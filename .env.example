# Site specifics
SITE_NAME="nano"
NEXT_PUBLIC_FW_STOREFRONT_TOKEN="ptkn_..."

NEXT_PUBLIC_FW_CHECKOUT="https://vercel-shop.fourthwall.com"
NEXT_PUBLIC_VERCEL_URL="https://fw-commerce.vercel.app"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"

# Optional configuration
NEXT_PUBLIC_FW_COLLECTION="launch"
NEXT_PUBLIC_USE_FW_IMAGE_OPTIMIZATION="true"
FOURTHWALL_WEBHOOK_SECRET="your-webhook-secret"

# Database (Vercel Postgres / Neon) — required for /admin attributes & catalog filters
# Vercel Postgres also injects POSTGRES_URL; either works.
DATABASE_URL="postgres://..."
# POSTGRES_URL="postgres://..."

# Fourthwall Open API (fulfillment tracking sync)
FOURTHWALL_OPEN_API_USER=""
FOURTHWALL_OPEN_API_PASSWORD=""

# Prodigi dropship
PRODIGI_API_KEY=""
ART_ASSET_BASE_URL="https://your-art-storage.com/masters"

# Optional alerts for ORIGINAL-* orders
SLACK_WEBHOOK_URL=""

# For developers
NEXT_PUBLIC_FW_API_URL="https://storefront-api.fourthwall.com"
NEXT_PUBLIC_GTM_ID="GTM-xxxxxxx"
